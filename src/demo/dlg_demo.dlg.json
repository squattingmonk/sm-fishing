        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "If that's all too much for you, you can download a few presets from https://github.com/squattingmonk/sm-fishing/examples. These presets come in minimal, lite, and full varieties. Each has its own readme with simple installation instructions."
          }
        }
